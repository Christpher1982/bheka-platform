# ── Compiled output ──────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
*.tsbuildinfo
.expo/
.expo-shared/

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Secrets & environment files ───────────────────────────────────────────────
# Never commit real credentials. Use Replit Secrets (or a vault) instead.
.env
.env.*
!.env.example

# ── IDEs & editors ────────────────────────────────────────────────────────────
/.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── System files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Coverage & logs ──────────────────────────────────────────────────────────
/coverage/
*.log
npm-debug.log
yarn-error.log
testem.log
/libpeerconnection.log

# ── Other build noise ────────────────────────────────────────────────────────
/.sass-cache/
/connect.lock/
/typings/

# ── Replit agent/platform internals ─────────────────────────────────────────
# .local/ holds the agent's runtime skills & scripts — not source code.
# Keep out of the repo; it is regenerated by Replit on each session.
.local/
.cache/
# Auto-generated Nx / Cursor rule files (workspace tooling noise)
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# ── INTENTIONALLY COMMITTED ──────────────────────────────────────────────────
# The following are tracked on purpose; do NOT add them above:
#
#   attached_assets/    — 80 spec documents (CANON, GUIDEs, RUNBOOKs, diagrams)
#   .agents/memory/     — 9 agent memory files (build decisions & lessons learned)
#   .replit             — Replit workspace config (ports, workflows, preview)
#   replit.nix          — Nix package manifest for the dev environment
#   .replitignore       — Controls which files Replit excludes from deployments
