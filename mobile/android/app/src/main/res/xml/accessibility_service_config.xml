<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration for BhekaAccessibilityService.
  We listen only for text-change and focus events system-wide; we do not
  need to inspect full window content trees, which keeps overhead low.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewTextChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames=""
    android:settingsActivity="io.bheka.agent.MainActivity" />
