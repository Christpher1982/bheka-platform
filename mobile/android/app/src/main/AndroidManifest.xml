<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access to reach the Bheka API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service (Android 9+ requires the permission; Android 14+
         requires a typed foreground-service permission as well). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Restart monitoring automatically after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Required to query which app is currently in the foreground -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- MediaProjection screen capture -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Post persistent notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera for QR-code enrollment scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Keep the CPU awake while monitoring loops are running -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".BhekaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BhekaAgent"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Enrollment / first-launch UI. Also the entry point for
             re-opening the app to change config or re-grant permissions. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent activity used solely to request the MediaProjection
             capture token via startActivityForResult. -->
        <activity
            android:name=".MediaProjectionRequestActivity"
            android:exported="false"
            android:theme="@style/Theme.BhekaAgent.Transparent" />

        <!-- QR code scanner activity (from zxing-android-embedded). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <!-- Persistent foreground service orchestrating all monitoring loops. -->
        <service
            android:name=".BhekaMonitoringService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Accessibility service used to capture keystroke / text-change events. -->
        <service
            android:name=".BhekaAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Restarts the monitoring service after device reboot. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
